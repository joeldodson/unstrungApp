  "playabilityRules": {
    "open": {
      "description": "A voicing with no barre, within the first three frets.",
      "requireVoicing": true,
      "maxLowestFret": 3,
      "allowBarres": false,
      "maxFretSpan": 3,
      "confidences": ["canonical", "common"]
    },
    "fingered": {
      "description": "Any known fingering that does not span more than four frets.",
      "requireVoicing": true,
      "maxLowestFret": 12,
      "allowBarres": true,
      "maxFretSpan": 4,
      "confidences": ["canonical", "common", "advanced"]
    },
    "any": {
      "description": "Any chord at all, including ones with no fingering in the library.",
      "requireVoicing": false
    }
  }
