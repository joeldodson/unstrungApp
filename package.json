{
  "name": "unstrung",
  "version": "0.6.0",
  "description": "Accessible, screen-reader-friendly viewer for song composition files (Guitar Pro and similar formats).",
  "private": true,
  "author": "Joel Dodson",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "node scripts/copy-font.mjs && esbuild src/renderer/renderer.js --bundle --outfile=src/renderer/bundle.js --platform=browser --format=iife",
    "build:chords": "node scripts/build-chord-library.mjs",
    "build:help": "node scripts/build-help.mjs",
    "build:icons": "electron scripts/build-icons.js",
    "start": "npm run build:renderer && electron .",
    "build:web-audio": "node scripts/build-web-audio.mjs",
    "start:web-audio": "npm run build:renderer && electron . --web-audio",
    "build:web": "node scripts/build-web-audio.mjs && node scripts/build-web.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "postinstall": "npm run build:renderer",
    "dist": "npm run build:help && npm run build:renderer && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@tombatossals/chords-db": "^0.5.1",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.23.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.62.0"
  },
  "build": {
    "appId": "com.joeldodson.unstrung",
    "productName": "Unstrung",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/**/*",
      "src/shared/**/*",
      "src/assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.23.1": true,
    "ffmpeg-static@5.3.0": true
  }
}
