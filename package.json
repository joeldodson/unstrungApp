{
  "name": "unstrung",
  "version": "0.1.1",
  "description": "Accessible, screen-reader-friendly viewer for song composition files (Guitar Pro and similar formats).",
  "private": true,
  "author": "Joel Dodson",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/renderer.js --bundle --outfile=src/renderer/bundle.js --platform=browser --format=iife",
    "build:chords": "node scripts/build-chord-library.mjs",
    "build:help": "node scripts/build-help.mjs",
    "start": "npm run build:renderer && electron .",
    "postinstall": "npm run build:renderer",
    "dist": "npm run build:help && npm run build:renderer && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@tombatossals/chords-db": "^0.5.1",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.23.0",
    "playwright-core": "^1.62.0"
  },
  "build": {
    "appId": "com.joeldodson.unstrung",
    "productName": "Unstrung",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/**/*",
      "src/assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
