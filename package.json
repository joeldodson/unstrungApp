{
  "name": "unstrung",
  "version": "0.1.1",
  "description": "Accessible, screen-reader-friendly viewer for song composition files (Guitar Pro and similar formats).",
  "private": true,
  "author": "Joel Dodson",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/renderer.js --bundle --outfile=src/renderer/bundle.js --platform=browser --format=iife",
    "start": "npm run build:renderer && electron .",
    "postinstall": "npm run build:renderer",
    "dist": "npm run build:renderer && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "@coderline/alphatab": "^1.8.4",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.23.0"
  },
  "build": {
    "appId": "com.joeldodson.unstrung",
    "productName": "Unstrung",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
